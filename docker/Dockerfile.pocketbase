# Build stage - download PocketBase
FROM alpine:3.18 AS builder

RUN apk add --no-cache wget unzip binutils

ARG POCKETBASE_VERSION=0.36.1
RUN wget https://github.com/pocketbase/pocketbase/releases/download/v${POCKETBASE_VERSION}/pocketbase_${POCKETBASE_VERSION}_linux_amd64.zip \
    && unzip pocketbase_${POCKETBASE_VERSION}_linux_amd64.zip \
    && strip pocketbase \
    && chmod +x pocketbase

# Runtime stage - needs shell for init script and Python for batch import
FROM alpine:3.18

WORKDIR /app

# Build arguments for version metadata
ARG APP_VERSION=unknown
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown

# Set environment variables for runtime access
ENV APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA} \
    BUILD_TIME=${BUILD_TIME}

# Install curl for health checks and Python for batch import script
RUN apk add --no-cache curl python3

# Copy PocketBase binary from builder
COPY --from=builder /pocketbase /app/pocketbase

# Copy schema, hooks, import script, and init script
COPY pocketbase/pb_schema.json /app/pb_schema.json
COPY pocketbase/pb_hooks /app/pb_hooks
COPY pocketbase/import_schema.py /app/import_schema.py
COPY pocketbase/init_pocketbase.sh /app/init_pocketbase.sh
RUN chmod +x /app/init_pocketbase.sh

# Create non-root user
RUN addgroup -g 1000 pocketbase && \
    adduser -D -u 1000 -G pocketbase pocketbase && \
    chown -R pocketbase:pocketbase /app

USER pocketbase

EXPOSE 8080

ENTRYPOINT ["/app/init_pocketbase.sh"]
